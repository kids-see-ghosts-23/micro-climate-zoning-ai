/*--------------------------------*- C++ -*----------------------------------*\
  OpenFOAM blockMeshDict — simple urban canyon domain
  500m x 500m x 100m, 50x50x20 cells
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale   1;

vertices
(
    ( 0    0    0)   // 0
    (500   0    0)   // 1
    (500 500    0)   // 2
    ( 0  500    0)   // 3
    ( 0    0  100)   // 4
    (500   0  100)   // 5
    (500 500  100)   // 6
    ( 0  500  100)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (50 50 20) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    ground
    {
        type wall;
        faces ((0 1 2 3));
    }
    top
    {
        type symmetryPlane;
        faces ((4 5 6 7));
    }
    sides
    {
        type symmetryPlane;
        faces ((0 1 5 4) (3 7 6 2));
    }
);
