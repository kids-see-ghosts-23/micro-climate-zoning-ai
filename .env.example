# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=microclimate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/microclimate

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=gee-key.json
GEE_PROJECT=your-gcp-project-id

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-secret-key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Model
PINN_MODEL_PATH=ai_model/checkpoints/latest.pt
OPENFOAM_CASE_DIR=simulation/base_case
